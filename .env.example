# ==============================================================================
# GraphRAG-1 Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neo4j Graph Database
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=graphragv2

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration (Default: OpenRouter)
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-openrouter-key
LLM_MODEL=openrouter/free

# Optional role-specific model overrides (fallback to LLM_MODEL if unset)
ROUTER_MODEL=openrouter/free
ANSWER_MODEL=openrouter/free
JUDGE_MODEL=openrouter/free

# Request timeout in seconds (default: 300)
LLM_TIMEOUT=300

# Disk Cache: set to 1 to enable disk caching in .cache/llm/
LLM_CACHE=0

# ------------------------------------------------------------------------------
# 3. Example: Local Ollama / Cloudflare Tunnel Configuration
# To use a local Ollama instance or an Ollama server behind a Cloudflare tunnel:
# ------------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# # Or behind a Cloudflare tunnel:
# # LLM_BASE_URL=https://your-tunnel-subdomain.trycloudflare.com/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=qwen2.5:7b
# ROUTER_MODEL=qwen2.5:7b
# ANSWER_MODEL=qwen2.5:7b
# JUDGE_MODEL=qwen2.5:7b
# LLM_TIMEOUT=600
# LLM_CACHE=1

# ------------------------------------------------------------------------------
# 4. Backward-Compatible Legacy Aliases (optional)
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

